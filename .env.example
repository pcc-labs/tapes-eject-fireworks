# Where sessions come from: tapes (a local tapes stack, the default) or paper (a Paper org)
TAPES_EJECT_SOURCE=tapes
# The local tapes API; tapes-test serves it here
TAPES_API=http://127.0.0.1:18081
# Fireworks API key (dashboard, or `firectl api-key create`). Only training and `ask` need it
FIREWORKS_API_KEY=
# A model the catalog lists with Availability "Serverless", and its HuggingFace tokenizer
TAPES_EJECT_BASE_MODEL=accounts/fireworks/models/kimi-k3
TAPES_EJECT_TOKENIZER=moonshotai/Kimi-K3
# Serverless chat model that judges base and tuned answers against the eval guidelines
TAPES_EJECT_JUDGE_MODEL=accounts/fireworks/models/kimi-k3
# Paper only: an autolabel service for `label`, including its route prefix
AUTOLABEL_URL=http://127.0.0.1:9996/v1/cassettes/autolabel
# Paper only: org slug; empty uses paperctl's active org
PAPER_ORG_SLUG=
# How many recent non-empty sessions to export beyond the labeled ones; they are the denominator
# of the per-model and per-project rates, and the unlabeled ones with an outcome are training data
TAPES_EJECT_SAMPLE_SESSIONS=400
# Sessions longer than this are not exported
TAPES_EJECT_MAX_TURNS=150
# Sessions whose rollup shows more output tokens than this are not exported either. Turn count
# misses a three-turn session with enormous tool output, and exporting one is slow and can overload the API
TAPES_EJECT_MAX_OUTPUT_TOKENS=400000
# Session ids (comma-separated) never to export, e.g. one too large to stream
TAPES_EJECT_SKIP_SESSIONS=
